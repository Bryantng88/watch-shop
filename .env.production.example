# Docker/NAS binding. Use 127.0.0.1 when the NAS reverse proxy can reach the host port.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=3000
IMAGE_TAG=local
APP_ENV_FILE=.env.production
BUILD_ENV_FILE=.env.build

# Application and database
APP_URL=https://watch.example.internal
# Set false only when the app is restricted to trusted LAN/WireGuard HTTP access.
AUTH_COOKIE_SECURE=true
# At least 32 random characters. Changing it signs every user out.
AUTH_SECRET=replace-with-at-least-32-random-characters
# Independent salts for public ingress and anonymous analytics fingerprints.
PUBLIC_ORDER_FINGERPRINT_SECRET=replace-with-a-long-random-secret
STOREFRONT_ANALYTICS_SALT=replace-with-a-different-long-random-secret
# A NAS container is a persistent backend. Prefer the Supabase direct endpoint
# when the NAS has IPv6; otherwise use the Supavisor session pooler on port 5432.
DATABASE_URL=postgresql://PRISMA_USER.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5&pool_timeout=10
# Use the direct endpoint for migrations and backups. It requires IPv6 or the
# Supabase IPv4 add-on. If unavailable, use the session-pooler URL above here too.
DIRECT_URL=postgresql://PRISMA_USER:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_READINESS_TIMEOUT_MS=5000

# Host path mounted by the optional database-backup Compose profile.
DB_BACKUP_DIR=./backups/database
DB_BACKUP_RETENTION_DAYS=14

# S3-compatible media storage
S3_ENDPOINT=https://s3.example.internal
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=watch-shop
NEXT_PUBLIC_S3_PUBLIC_BASE=https://media.example.internal
CDN_DOMAIN=
IMG_PREFIX=
# Fail closed by default. Set to 0 only on a controlled staging environment
# while standardized storefront cover photography is being introduced.
STOREFRONT_REQUIRE_COVER_IMAGE=1

# Protected scheduled jobs
INTERNAL_JOB_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-different-long-random-secret
BUSINESS_EVENT_CONSUMER_TIMEOUT_MS=10000

# Projection rollout flags
WATCH_LIST_PROJECTION_READ=1
WATCH_LIST_PROJECTION_FALLBACK=0
WATCH_MEDIA_QUEUE_PROJECTION_READ=1
NEXT_PUBLIC_WATCH_INLINE_REPAIR=0

# Optional integrations
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=
ZALO_OA_SEND_URL=
ZALO_OA_TOKEN_URL=
ZALO_OA_TIMEOUT_MS=10000
ZALO_OA_TOKEN_TIMEOUT_MS=10000
# Carrier integration is disabled until a deployment receives dedicated
# sandbox/production credentials. Staging must never use production endpoints.
CARRIER_ENVIRONMENT=production
CARRIER_PROVIDER=MOCK
CARRIER_WEBHOOK_SECRET=
NEXT_PUBLIC_CARRIER_TEST_UI=0
VIETTEL_POST_BASE_URL=https://partnerdev.viettelpost.vn
VIETTEL_POST_TOKEN=
VIETTEL_POST_SENDER_NAME=
VIETTEL_POST_SENDER_PHONE=
VIETTEL_POST_SENDER_ADDRESS=
VIETTEL_POST_SERVICE_CODE=
VIETTEL_POST_SERVICE_ADD=
NEXT_PUBLIC_STOREFRONT_ZALO_URL=
NEXT_PUBLIC_STOREFRONT_INSTAGRAM_URL=https://www.instagram.com/vinticwatch/
NEXT_PUBLIC_STOREFRONT_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61585747980904
# Purchase-request email verification (Resend)
NEXT_PUBLIC_STOREFRONT_URL=https://watch.example.com
RESEND_API_KEY=
STOREFRONT_EMAIL_FROM=Vintic Watch <requests@example.com>
