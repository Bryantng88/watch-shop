# Public-host server block only. Keep the existing admin/LAN virtual host separate.
# Replace the host and upstream values during NAS configuration.
server {
    listen 443 ssl http2;
    server_name shop.example.com;

    ssl_certificate     /path/to/fullchain.pem;
    ssl_certificate_key /path/to/privkey.pem;

    client_max_body_size 64k;
    proxy_connect_timeout 5s;
    proxy_read_timeout 20s;
    proxy_send_timeout 20s;

    location = / { proxy_pass http://127.0.0.1:3000; include proxy_params; }
    location = /request { proxy_pass http://127.0.0.1:3000; include proxy_params; }
    location = /offline { proxy_pass http://127.0.0.1:3000; include proxy_params; }
    location = /manifest.webmanifest { proxy_pass http://127.0.0.1:3000; include proxy_params; }
    location = /sw.js { proxy_pass http://127.0.0.1:3000; include proxy_params; }
    location = /storefront-icon.svg { proxy_pass http://127.0.0.1:3000; include proxy_params; }
    location = /vintic-v.svg { proxy_pass http://127.0.0.1:3000; include proxy_params; }
    location = /storefront-maskable.svg { proxy_pass http://127.0.0.1:3000; include proxy_params; }

    location ^~ /products { proxy_pass http://127.0.0.1:3000; include proxy_params; }
    location ^~ /api/public/ { proxy_pass http://127.0.0.1:3000; include proxy_params; }
    location = /api/analytics/events { proxy_pass http://127.0.0.1:3000; include proxy_params; }
    location = /api/integrations/zalo/events { proxy_pass http://127.0.0.1:3000; include proxy_params; }
    location ^~ /_next/static/ { proxy_pass http://127.0.0.1:3000; include proxy_params; }
    location = /_next/image { proxy_pass http://127.0.0.1:3000; include proxy_params; }

    # Everything else, including /admin, /api/admin, /api/media, /login,
    # /profile, /api/internal and health/operations endpoints, stays private.
    location / { return 404; }
}
