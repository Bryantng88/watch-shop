# Store the real file outside Git, mode 600, readable only by the dedicated worker.
PERSONAL_CODEX_ENVIRONMENT=staging
PERSONAL_CODEX_APP_URL=http://watch-shop-storefront-staging-admin-app:3000
PERSONAL_CODEX_ALLOW_PRIVATE_HTTP=1
PERSONAL_CODEX_WORKER_ID=staging-codex-1
PERSONAL_CODEX_WORKER_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PERSONAL_CODEX_REPO_ROOT=/var/lib/watch-shop-codex/repo
PERSONAL_CODEX_PUBLISH_DRAFT_PRS=1
# Only on the isolated worker, never in the web app or agent tool environment:
GH_TOKEN=SUPPLY_A_REPOSITORY_SCOPED_TOKEN_VIA_SECRET_CONFIGURATION
# Authenticate Codex with its dedicated account/profile or an OPENAI_API_KEY secret.
# Never reuse the NAS production runner, its workspace, or its credentials.
