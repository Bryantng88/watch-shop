      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "customerId": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 100
            },
            "productId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,29}$"
                  },
                  "requirement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1500
                  },
                  "expected": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1500
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "TECHNICAL",
                      "TASK"
                    ]
                  },
                  "assigneeUserId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "technicalDetailId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "key",
                  "requirement",
                  "expected",
                  "kind",
                  "assigneeUserId",
                  "technicalDetailId"
                ]
              }
            }
          },
          "required": [
            "customerId",
            "productId",
            "conditions"
          ]
        }
      ]
    },
    "permissionRequest": {
      "type": [
        "string",
        "null"
