{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "lookup",
        "finish"
      ]
    },
    "tool": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "customers.search",
        "watches.search",
        "watches.detail",
        "accessories.search",
        "work.open",
        "people.search",
        "technical.catalog",
        null
      ]
    },
    "query": {
      "type": [
        "string",
        "null"
      ]
    },
    "productId": {
      "type": [
        "string",
        "null"
      ]
    },
    "customerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "reply": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1500
    },
    "plan": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "customerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "productId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,29}$"
                  },
                  "requirement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1500
                  },
                  "expected": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1500
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "TECHNICAL",
                      "TASK"
                    ]
                  },
                  "assigneeUserId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "technicalDetailId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "key",
                  "requirement",
                  "expected",
                  "kind",
                  "assigneeUserId",
                  "technicalDetailId"
                ]
              }
            }
          },
          "required": [
            "customerId",
            "productId",
            "conditions"
          ]
        }
      ]
    }
  },
  "required": [
    "type",
    "tool",
    "query",
    "productId",
    "customerId",
    "reply",
    "plan"
  ]
}
