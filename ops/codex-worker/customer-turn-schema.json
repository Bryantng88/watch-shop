            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "productId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "unitPriceAgreed": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9999999999
                  }
