# Values in this file are available only while running `next build`.
# NEXT_PUBLIC values are embedded in browser bundles and cannot be changed when
# a container starts. Do not put runtime-only credentials in this file.

# If Next.js prerendering accesses the database, use a restricted, read-only
# build account. Remove this entry once every database-backed route is dynamic.
DATABASE_URL=postgresql://BUILD_USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true

# Public build-time configuration
NEXT_PUBLIC_S3_PUBLIC_BASE=https://media.example.internal
NEXT_PUBLIC_WATCH_INLINE_REPAIR=0
