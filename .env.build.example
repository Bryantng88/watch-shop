# Values in this file are available only while running `next build`.
# NEXT_PUBLIC values are embedded in browser bundles and cannot be changed when
# a container starts. Do not put runtime-only credentials in this file.

# If Next.js prerendering accesses the database, use a restricted, read-only
# build account through the Supabase session pooler. Remove this entry once every
# database-backed route is dynamic.
DATABASE_URL=postgresql://BUILD_USER.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=2&pool_timeout=10

# Public build-time configuration
NEXT_PUBLIC_S3_PUBLIC_BASE=https://media.example.internal
NEXT_PUBLIC_WATCH_INLINE_REPAIR=0
NEXT_PUBLIC_STOREFRONT_ZALO_URL=
NEXT_PUBLIC_STOREFRONT_INSTAGRAM_URL=https://www.instagram.com/vinticwatch/
NEXT_PUBLIC_STOREFRONT_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61585747980904
