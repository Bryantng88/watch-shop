{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next-dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "component for chatGPT",
    "src/features/__generated__",
    "src/app/(admin)/admin/services/_server",
    "src/app/(admin)/admin/products",
    "src/app/(admin)/admin/acquisitions/_client",
    "src/app/(admin)/admin/acquisitions/_server",
    "src/app/(admin)/admin/acquisitions/components",
    "src/app/(admin)/admin/acquisitions/hooks",
    "src/components/common/Header/Header.tsx",
    "src/components/common/Header/Header2.tsx",
    "src/components/hooks/useCart.ts",
    "src/domains/task/client/TaskTypeSettingsClient copy.tsx",
    "src/server/jobs/generate-spec.job.ts"
  ]
}
